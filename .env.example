# Supabase — crea un proyecto gratuito en https://supabase.com (no pide tarjeta)
# y copia estos tres valores desde Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: solo se usa en el servidor (eliminar cuenta). Nunca la expongas con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional. Sin esto, Vence funciona en modo demostración (datos de
# ejemplo claramente marcados, nunca presentados como análisis real).
ANTHROPIC_API_KEY=

# Necesario en producción para que los enlaces de acceso por email apunten
# al dominio correcto. En local no hace falta (se infiere del request).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
