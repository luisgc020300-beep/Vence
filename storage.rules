rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/documentos/{allPaths=**} {
      // read y write por separado: request.resource solo existe al escribir
      // -- combinarlos con las mismas condiciones hacía que request.resource
      // fuera null en cada lectura (getDownloadURL), y esa regla fallaba
      // "cerrada" (denegada) siempre, aunque el archivo existiera.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
    }
  }
}
